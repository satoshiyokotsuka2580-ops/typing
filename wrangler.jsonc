{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "typing",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-18",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "typing-ranking-db",
      "database_id": "656f7f8f-0a05-4169-9ecb-c6cf14a80411"
    }
  ],

  "observability": {
    "enabled": true
  }
}